# --- Auth0 (Regular Web Application of the Sobremesas tenant) ---
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32+ random bytes: openssl rand -hex 32
AUTH0_SECRET=
# Must match the API's AUTH0_AUDIENCE, or Auth0 issues an opaque token the API cannot verify
AUTH0_AUDIENCE=https://api.sobremesasecompanhia.pt
# Where this app runs (Auth0 callback = {APP_BASE_URL}/auth/callback)
APP_BASE_URL=http://localhost:3000

# --- API (server-only; the browser always goes through /api/backend) ---
BACKEND_URL=http://localhost:8080

# --- Public URL used for canonical/hreflang links ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The presentation site, linked from the header/footer
NEXT_PUBLIC_LANDING_URL=https://sobremesasecompanhia.pt
