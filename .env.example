# --- Sign-in (backoffice staff; Google sign-in or e-mail code, no passwords) ---
# OAuth 2.0 client id (type "Web application", origins http://localhost:3000 + https://dev.sobremesasecompanhia.pt)
# for the Google sign-in button. Same value as the API's GOOGLE_SIGNIN_CLIENT_ID. Unset = e-mail code only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- API (server-only; the browser always goes through /api/backend and /api/auth) ---
BACKEND_URL=http://localhost:8080

# --- Public URL used for canonical/hreflang links ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contacts (WhatsApp, Instagram, Facebook, service area) live in src/content/site.ts.

# --- Cache refresh after backoffice edits (same value as the API's REVALIDATE_SECRET) ---
# REVALIDATE_SECRET=
